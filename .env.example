NODE_ENV=production
PORT=3337
JWT_SECRET=votre-secret-jwt-tres-long-et-securise-ici

DB_DRIVER=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=caisse_topcenter
MYSQL_USER=caisse_user
MYSQL_PASSWORD=changer-ce-mot-de-passe
MYSQL_ROOT_PASSWORD=changer-ce-root-password

# Chemin historique SQLite conserve uniquement pour migration/import controle.
DB_PATH=/app/backend/data/caisse.db

# Dolibarr integration is disabled by default. Keep the API key server-side only.
DOLIBARR_ENABLED=false
DOLIBARR_BASE_URL=
DOLIBARR_API_KEY=
DOLIBARR_ENTITY_ID=
DOLIBARR_BANK_ACCOUNT_ID=
DOLIBARR_TIMEOUT_MS=10000
DOLIBARR_SYNC_MODE=manual
